# ── Sessions (required in production; dev generates its own key in ./data)
# 32+ random characters. Signs the wallet session cookie.
SESSION_SECRET=

# ── Storage (optional). Directory for the SQLite database.
# Defaults to ./data. Must be a persistent disk in production.
MIRROR_DATA_DIR=

# ── Network (optional overrides; defaults are in src/config/network.ts)
# RPC_URL is what the server reads the chain with. Point it at the local fork
# (http://127.0.0.1:8637) only for the rehearsal described in the README.
RPC_URL=
NEXT_PUBLIC_RPC_URL=

# ── Swap route (recommended in production). Without a key LI.FI rate-limits
# quotes per IP ("retry in 1 hour" was hit during development). Server only.
LIFI_API_KEY=

# ── Optional
NEXT_PUBLIC_CONTACT_EMAIL=

# There is no private key anywhere in this app: users sign in their own wallet.
